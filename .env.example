# Supabase (the Files-vault project) — email capture inserts via /api/subscribe.
# These are the BROWSER-SAFE publishable values (the same ones already public in the
# Files-vault client bundle). The /api/subscribe route falls back to baked-in public
# defaults if these are unset, so the form works without any env setup.
# NEVER put the service_role (secret) key here or anywhere in this app.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Optional: salt used to hash IPs in the subscribe rate-limiter (no raw IPs are stored).
SUBSCRIBE_SALT=change-me
